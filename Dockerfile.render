FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    RAGEVAL_RUNS_DIR=/app/experiments/runs \
    RAGEVAL_DATA_DIR=/app/data

WORKDIR /app
COPY requirements-lock-fast.txt pyproject.toml README.md LICENSE ./
COPY rageval ./rageval
COPY data ./data
COPY configs ./configs
COPY reports ./reports
COPY scripts/start_full_service.py ./scripts/start_full_service.py
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-lock-fast.txt \
    && python -m pip install --no-cache-dir --no-deps . \
    && useradd --create-home --uid 1000 rageval \
    && mkdir -p /app/experiments/runs \
    && chown -R rageval:rageval /app
USER rageval
EXPOSE 8000
CMD ["python", "scripts/start_full_service.py"]
