# Copy to .env (gitignored). Never put a live key in git or in this file.
# CLI commands load .env via rageval.core.envfile. HTTP serve does not.

# NVIDIA_API_KEY=
# OPENAI_API_KEY=
# RAGEVAL_API_KEY=

# RAGEVAL_RUNS_DIR=experiments/runs
# RAGEVAL_DATA_DIR=data
# RAGEVAL_INCLUDE_SNAPSHOTS=1

# Comma-separated. Use * only if you also accept credentials=false.
# RAGEVAL_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# RAGEVAL_ALLOWED_HOSTS=*
# RAGEVAL_RATE_LIMIT_PER_MINUTE=60
